{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "types": [],
    "module": "commonjs",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "rootDir": "..",
    "outDir": "./out/build"
  },
  "include": ["./env.d.ts", "./fixtures.ts", "./html.ts", "./render.ts", "./sheet.ts"]
}
